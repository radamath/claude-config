[Unit]
Description=Pull claude-config and apply it to ~/.claude

[Service]
Type=oneshot
# A hung run must not stall the timer forever (oneshot has no start timeout by default).
TimeoutStartSec=5min
# Login shell so ~/.local/bin (claude) is on PATH. install.sh records pull failures in the status file.
ExecStart=/bin/bash -lc 'exec "$HOME/.claude-config/repo/scripts/install.sh" --target vps --pull'
